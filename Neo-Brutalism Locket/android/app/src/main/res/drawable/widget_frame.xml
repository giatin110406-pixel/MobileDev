<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-brutalist card: thick ink border and a hard offset shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1A1A" />
        </shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFE66D" />
            <stroke android:width="3dp" android:color="#FF1A1A1A" />
        </shape>
    </item>
</layer-list>
